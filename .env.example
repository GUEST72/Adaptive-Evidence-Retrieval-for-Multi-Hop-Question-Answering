# Optional override for the directory containing train.jsonl and dev.jsonl.
# Paths may be absolute or relative to the repository root.
MUSIQUE_DATA_DIR=data/musique_ans

# Required for the Task 3 QA baseline (baseline/llm_client.py).
GROQ_API_KEY=your-key-here

# Alternative backends for the QA baseline (set `provider:` in configs/*.yaml).
# Gemini's free tier has a far larger daily budget than Groq's 200k tokens/day.
GEMINI_API_KEY=your-key-here

# Ollama runs locally with no quota; only needed if the default host differs.
OLLAMA_HOST=http://localhost:11434
